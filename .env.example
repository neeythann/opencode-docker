# Provider credentials (optional; opencode reads whichever you set)
# OLLAMA_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

OPENCODE_SERVER_USERNAME=opencode
ROOT_PASSWORD=set_me
PROJECT_DIR=./opencode

# Host address and port the container is published on.
# Use 127.0.0.1 to keep it local, or a specific interface/VPN address.
# Do not use 0.0.0.0 on a host with a public IP.
OPENCODE_BIND=127.0.0.1
OPENCODE_PORT=4096
